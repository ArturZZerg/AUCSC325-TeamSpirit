DATABASE_URL=postgresql://campusflow:campusflow_local_only@127.0.0.1:5432/campusflow
PORT=3000
HOST=127.0.0.1
# A comma-separated allowlist in deployed environments. Do not use * with credentials.
CORS_ORIGIN=http://localhost:8081
# Development-only Canvas access. Use CANVAS_MODE=fixture for deterministic local data,
# or CANVAS_MODE=token with an account-generated Canvas access token.
CANVAS_MODE=fixture
CANVAS_BASE_URL=https://canvas.ualberta.ca
CANVAS_ACCESS_TOKEN=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CANVAS_TOKEN_ENCRYPTION_KEY=
# Production OAuth still requires an institution-approved developer key and callback.
CANVAS_CLIENT_ID=
CANVAS_CLIENT_SECRET=
CANVAS_CALLBACK_URL=
