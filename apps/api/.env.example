DATABASE_URL=postgresql://campusflow:campusflow_local_only@127.0.0.1:5432/campusflow
PORT=3000
HOST=127.0.0.1
# Production requires explicit non-loopback HTTPS origins with no paths or *.
# Native requests without Origin remain supported. See release-operations.md.
CORS_ORIGIN=http://localhost:8081
# Fixtures require both explicit settings. Never enable fixtures in production.
NODE_ENV=development
# Local preview issues ordinary sessions without marking mailboxes verified.
# Production defaults to closed. Set verified only after approved SMTP acceptance.
REGISTRATION_MODE=preview
CANVAS_MODE=fixture
# Live Canvas OAuth remains disabled pending institutional approval and implementation.
CANVAS_CLIENT_ID=
CANVAS_CLIENT_SECRET=
CANVAS_CALLBACK_URL=
# Reviewed public university calendars. Applies the CampusFeedState migration first.
# disabled preserves an existing deployment; augustana enables hourly live imports.
CAMPUS_CALENDARS=disabled

# Recovery is disabled until the approved sender/provider is configured and tested.
# API-only 32-byte random key in canonical base64; retain while mail is pending.
RECOVERY_DELIVERY=disabled
RECOVERY_OUTBOX_KEY=
RECOVERY_WEB_URL=
SMTP_HOST=
SMTP_PORT=465
# implicit TLS on 465, or certificate-verified STARTTLS on the provider's port.
SMTP_TLS_MODE=implicit
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
