{
  "compilerOptions": {
    "target": "ES2022", "module": "CommonJS", "moduleResolution": "Node",
    "outDir": "dist", "rootDir": ".", "strict": true, "esModuleInterop": true,
    "experimentalDecorators": true, "emitDecoratorMetadata": true, "skipLibCheck": true,
    "types": ["node", "jest"], "sourceMap": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"], "exclude": ["dist", "node_modules"]
}
